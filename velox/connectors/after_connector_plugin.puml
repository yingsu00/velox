            class HiveDataSink
            DataSink <|.. HiveDataSink

            class HiveSplitReader
            SplitReader <|- HiveSplitReader

            HiveTableHandle -[hidden]right-> HiveSplitReader
            HiveConnector -[hidden]right-> HiveSplitReader
        }

        ConnectorSplit -[hidden]down-> hive

            ConnectorObjectFactory -[hidden]down-> ConnectorColumnHandle
            ConnectorObjectFactory -[hidden]down-> ConnectorTableHandle
            ConnectorObjectFactory -[hidden]down-> ConnectorLocationHandle



            interface ConnectorSplit
            interface ConnectorColumnHandle
            interface ConnectorLocationHandle
            interface ConnectorTableHandle
            interface ConnectorInsertTableHandle
            interface ConnectorLocationHandle
            interface Connector
            interface DataSource
            interface DataSink
